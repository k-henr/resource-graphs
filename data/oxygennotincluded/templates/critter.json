{
    "tags": ["...TEMPLATE?:additionalTags"],
    "displayName": "TEMPLATE:displayName",
    "thumbName": "TEMPLATE:thumbName",
    "settings": [
        {
            "type": "ENUMERATE",
            "name": "Morph",
            "options": "TEMPLATE:morphs",
            "default": "TEMPLATE:defaultMorph"
        },
        { "type": "TOGGLE", "name": "Wild", "default": false },
        { "type": "TOGGLE", "name": "Cramped", "default": false },
        {
            "type": "NUMBER",
            "name": "Happiness",
            "default": 4
        },
        "...TEMPLATE?:additionalSettings"
    ],
    "consumes": [
        {
            "type": "MULTIPLIER",
            "multiplier": {
                "type": "SETTING",
                "name": "Wild",
                "true": 0,
                "false": {
                    "type": "THRESHOLD",
                    "value": { "type": "SETTING", "name": "Happiness" },
                    "threshold": 0,
                    "higherOrEqual": 1,
                    "lower": 0.2
                }
            },
            "resource": {
                "type": "AND",
                "resources": "TEMPLATE:consumeResource"
            }
        },
        "...TEMPLATE?:additionalConsume",
        {
            "type": "RESOURCE",
            "id": "TEMPLATE:egg",
            "amount": [1, "TEMPLATE:adultLifespan"]
        }
    ],
    "produces": [
        {
            "type": "MULTIPLIER",
            "multiplier": {
                "type": "THRESHOLD",
                "value": { "type": "SETTING", "name": "Happiness" },
                "threshold": 0,
                "higherOrEqual": {
                    "type": "SETTING",
                    "name": "Wild",
                    "true": 0.25,
                    "false": 1
                },
                "lower": {
                    "type": "SETTING",
                    "name": "Wild",
                    "true": 0.1,
                    "false": 0.2
                }
            },
            "resource": {
                "type": "AND",
                "resources": "TEMPLATE:produceResource"
            }
        },
        "...TEMPLATE?:additionalProduce",
        {
            "type": "MULTIPLIER",
            "multiplier": {
                "type": "SETTING",
                "name": "Cramped",
                "true": 0,
                "false": {
                    "type": "SETTING",
                    "name": "Wild",
                    "true": [1, "TEMPLATE:adultLifespan"],
                    "false": {
                        "type": "THRESHOLD",
                        "value": { "type": "SETTING", "name": "Happiness" },
                        "threshold": 1,
                        "lower": [1, "TEMPLATE:adultLifespan"],
                        "higherOrEqual": {
                            "type": "ADD",
                            "values": [
                                [1, "TEMPLATE:adultLifespan"],
                                {
                                    "type": "MUL",
                                    "values": [
                                        [1, "TEMPLATE:adultLifespan"],
                                        2.25,
                                        { "type": "SETTING", "name": "Happiness" }
                                    ]
                                }
                            ]
                        }
                    }
                }
            },
            "resource": { "type": "RESOURCE", "id": "TEMPLATE:egg", "amount": 1 }
        },
        {
            "type": "RESOURCE",
            "id": "meat",
            "amount": ["TEMPLATE:caloriesDropped", "TEMPLATE:adultLifespan"]
        }
    ]
}
